{
  "name": "com1-study-break",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "prettier --write index.html \"scripts/*.mjs\" \"supabase/functions/event-api/*.{js,ts}\" \"tests/*.mjs\"",
    "format:check": "prettier --check index.html \"scripts/*.mjs\" \"supabase/functions/event-api/*.{js,ts}\" \"tests/*.mjs\"",
    "build": "node scripts/build-site.mjs",
    "preview": "node scripts/preview.mjs",
    "test": "node --test tests/database.test.mjs tests/api.test.mjs",
    "test:ui": "node --test tests/ui.test.mjs",
    "test:live": "node --test tests/live.test.mjs",
    "pin:hash": "node scripts/hash-pin.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "bcryptjs": "3.0.3",
    "playwright": "1.56.1",
    "prettier": "3.9.10"
  }
}
